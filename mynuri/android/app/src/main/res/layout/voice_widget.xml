<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="8dp" android:background="#E5EEFA">
    <TextView android:id="@+id/voice_widget_text" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="음성 입력 켜기"
        android:textColor="#17345D" android:textStyle="bold" android:textSize="15sp" />
    <TextView android:id="@+id/voice_output_text" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="음성 출력 켜기"
        android:textColor="#17345D" android:textStyle="bold" android:textSize="15sp" />
</LinearLayout>
